# Cloudflare Workers static-asset headers: https://developers.cloudflare.com/workers/static-assets/headers/
# Vite writes its build output to /assets/ with a content hash in each file name, so a changed file
# always gets a new URL and browsers can keep these for a year without asking again.
# `:file` matches one path segment only, so unhashed files in /assets/ subfolders (copied from
# public/assets) keep Cloudflare's default revalidation. Keep it that way if you add files there.
/assets/:file
  Cache-Control: public, max-age=31536000, immutable
