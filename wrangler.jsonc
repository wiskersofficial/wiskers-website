{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wiskers-website",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["hello@wiskers.click"]
    }
  ],
  "previews": {},
  "observability": {
    "enabled": true
  }
}
